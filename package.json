{
  "name": "dozai",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions/*",
    "appsail/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev -w apps/web\"",
    "dev:api": "tsx watch scripts/dev-server.ts",
    "build": "npm run build -w apps/web",
    "build:cloud": "npm run build -w functions/core_api && npm run build -w appsail/mcp-gateway",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.4",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "express": "^4.21.0",
    "jsdom": "^30.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "zcatalyst-sdk-node": "^3.4.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
